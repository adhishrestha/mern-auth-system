# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=your_mongodb_connection_string
# Client
CLIENT_URL=http://localhost:5173

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_token
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_for_refresh_token
JWT_REAUTH_SECRET=replace_with_a_different_long_random_secret_for_reauthentication
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id